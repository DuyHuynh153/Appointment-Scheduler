# Copy to `.env` for local (non-Docker) runs. `docker-compose.yml` sets
# its own environment block and does not read this file directly.

ENVIRONMENT=local

# Sync SQLAlchemy connection string (psycopg driver) - see ADR-001 amendment.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/appointments
DB_ECHO=false

LOG_LEVEL=INFO

# Feature toggles - see ADR-004.
ENABLE_AUTO_ASSIGN=true
ENABLE_OVERLAP_VALIDATION=true
ENABLE_STRUCTURED_LOGGING=true

# Business rules constants - see IMPLEMENTATION_PLAN.md Section 4.
BUSINESS_HOURS_START=08:00
BUSINESS_HOURS_END=18:00

# Observability - see ADR-003.
CORRELATION_ID_HEADER=X-Correlation-ID
